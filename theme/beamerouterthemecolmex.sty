\mode<presentation>

\providecommand{\wc@numbering}{fraction}
\providecommand{\wc@breadcrumb}{on}

\makeatletter

\usepackage{hyperref}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Set the frame title and footer
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Frame title
\defbeamertemplate*{frametitle}{colmex}[1][]
{
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,sep=0pt,leftskip=0.55cm,rightskip=0.55cm,#1]{frametitle}
    \vskip0.15cm%
    \def\wc@tmp{none}\ifx\wc@breadcrumb\wc@tmp\else
      \ifnum\value{section}>0
        {\tiny\color{wcprimary!20}\MakeUppercase{\insertsectionhead}%
          \ifnum\value{subsection}>0
            \space\space›\space\space\MakeUppercase{\insertsubsectionhead}%
          \fi\par}%
        \vskip0.14cm%
      \fi
    \fi
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
    \ifx\insertframesubtitle\@empty\else%
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
    \fi%
    \vskip0.12cm%
  \end{beamercolorbox}%
}

% % Header (Navigation) - Uncomment if you want navigation symbols
 \setbeamertemplate{headline}{
%   % If page > 1 (don't diplsy for first page)
   \ifnum\thepage>1
     \begin{beamercolorbox}[wd=\paperwidth,ht=2.5ex,dp=1.125ex]{palette quaternary}
       \insertnavigation{\paperwidth} % Add navigation symbols
     \end{beamercolorbox}
   \fi
 }

% Footer (Pages)
%% NOTE: ON OVERLEAF USE ht=-2.5ex. Not sure why this is needed.
% Footer — fixed fraction frame numbering
\setbeamertemplate{footline}{%
  \ifbeamer@inappendix\else
    \ifnum\insertframenumber>1
      \begin{beamercolorbox}[
        wd=\paperwidth,
        ht=-2.5ex,
        dp=1.125ex,
        right
      ]{page number in head/foot}
        \usebeamerfont{page number in head/foot}%
        \color{black!20}%
        \ifnum\insertmainframenumber>1
          \the\numexpr\insertframenumber-1\relax
          /
          \the\numexpr\insertmainframenumber-1\relax
        \fi
        \hspace{1em}
      \end{beamercolorbox}
    \fi
  \fi
}

\makeatother

\mode<all>
